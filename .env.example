# 项目 B 独立配置模板；compose.demo.yaml 会显式启用真实 Agent、持久化与 MCP。
# 复制为 .env 后自行填写模型三项；密钥和生产登录配置绝不提交到仓库。
SKILLFLOW_MODEL_MODE=mock
# 使用真实模型时改为 langchain_openai，并自行填写模型服务地址与密钥。
SKILLFLOW_MODEL=
SKILLFLOW_BASE_URL=
SKILLFLOW_API_KEY=
# 默认直连模型接口；只有系统代理确实可用时才改为 true。
SKILLFLOW_MODEL_TRUST_ENV=false
SKILLFLOW_MODEL_TIMEOUT=30
SKILLFLOW_MODEL_RETRIES=1

# S1 默认沿用 legacy；新图必须显式选 tool_loop 和 scripted，且使用独立数据目录。
SKILLFLOW_AGENT_ENGINE=legacy
SKILLFLOW_AGENT_MODEL_MODE=disabled
# 演示新图时：将以上改为 tool_loop、scripted，并指定下列 B 内独立目录。
# SKILLFLOW_DATA_DIR=.skillflow/agent-s1-demo
SKILLFLOW_AGENT_MAX_ROUNDS=8
SKILLFLOW_AGENT_MAX_TOOL_ATTEMPTS=12
SKILLFLOW_AGENT_MAX_MODEL_REQUESTS=10
SKILLFLOW_AGENT_MODEL_TIMEOUT=30
SKILLFLOW_AGENT_ACTIVE_TIMEOUT=120

# 项目 B 质量事件演示需要显式启用 SQLAlchemy；默认 mock 保留原有订单与工单。
SKILLFLOW_BUSINESS_BACKEND=mock
# 可选隔离库目录，只能指向项目 B 内；不设置时沿用项目 B 的 .skillflow。
# SKILLFLOW_DATA_DIR=.skillflow/surge-tests/manual-demo
# 本机 SQLite 初值：同时执行 8 个、等待 64 个；容量满时返回 CHAT_BUSY。
SKILLFLOW_MAX_ACTIVE_CHATS=8
SKILLFLOW_MAX_WAITING_CHATS=64
# 正常使用 session；global 只用于与旧全局聊天锁比较的基线测试。
SKILLFLOW_CHAT_LOCK_MODE=session

# B6 默认保持演示模式；生产模式必须配置项目 B 自己的 HTTPS OIDC 身份提供方。
SKILLFLOW_AUTH_MODE=demo
# 以下四项仅在 production 模式启用；回调地址须对应身份提供方登记的地址。
SKILLFLOW_OIDC_ISSUER=
SKILLFLOW_OIDC_CLIENT_ID=
SKILLFLOW_OIDC_CLIENT_SECRET=
SKILLFLOW_OIDC_REDIRECT_URI=
# 身份提供方需要系统代理时才启用，独立于模型代理配置。
SKILLFLOW_OIDC_TRUST_ENV=false
# 服务端认证 Cookie 的有效时间（秒）；会话过期或退出后不能恢复旧请求。
SKILLFLOW_AUTH_SESSION_SECONDS=3600
